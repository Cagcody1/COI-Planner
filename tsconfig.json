{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": false, "skipLibCheck": true,
    "resolveJsonModule": true, "lib": ["ES2022", "DOM"], "types": ["node"], "noEmit": true
  },
  "include": ["src", "tests", "scripts", "tools/wiki-check"]
}
