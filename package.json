{
  "name": "coi-planner",
  "version": "0.1.15",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "data:proto": "tsx scripts/build-proto-data.ts",
    "data:validate": "tsx scripts/validate-data.ts",
    "wiki:check": "tsx tools/wiki-check/index.ts",
    "build:single": "tsc --noEmit && vite build --config vite.single.config.ts && node scripts/name-single.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^2.1.0"
  }
}
